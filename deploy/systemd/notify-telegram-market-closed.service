[Unit]
Description=Notify Telegram once per day when NYSE is closed (weekend/holiday)
After=network.target

[Service]
Type=oneshot
User=tradingapp
WorkingDirectory=/home/tradingapp/app/backend
EnvironmentFile=/home/tradingapp/app/backend/.env
ExecStart=/home/tradingapp/app/backend/.venv/bin/python /home/tradingapp/app/scripts/notify-telegram.py market-closed
TimeoutSec=15

[Install]
WantedBy=multi-user.target
