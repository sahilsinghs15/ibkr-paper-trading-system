[Unit]
Description=IBKR IB Gateway (Xvfb + IBC) — trading-hours controlled, triggers Backend
After=network.target
Wants=network.target
Before=trading-backend.service

[Service]
Type=simple
User=tradingapp
WorkingDirectory=/home/tradingapp/app
EnvironmentFile=/home/tradingapp/app/backend/.env
ExecStartPre=/home/tradingapp/app/backend/.venv/bin/python /home/tradingapp/app/scripts/holiday_guard.py
ExecStart=/bin/bash /home/tradingapp/app/scripts/ibgateway-wrapper.sh
ExecStopPost=-/bin/bash -c 'rm -f /tmp/.X99-lock /tmp/.X11-unix/X99 || true; cd /home/tradingapp/app/backend && /home/tradingapp/app/backend/.venv/bin/python -m app.services.notification.cli stop ibgateway'
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=1 2
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ibgateway

NoNewPrivileges=true
PrivateTmp=true

[Install]
# Intentionally disabled in multi-user.target; lifecycle controlled by trading-session-start/stop timers
