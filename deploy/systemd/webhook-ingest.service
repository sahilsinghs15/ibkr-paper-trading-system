[Unit]
Description=IBKR Webhook Ingest (FastAPI :8000) — 24/7 durable ingest
After=network.target postgresql.service
Wants=postgresql.service
Requires=network.target

[Service]
Type=simple
User=tradingapp
WorkingDirectory=/home/tradingapp/app/backend
EnvironmentFile=/home/tradingapp/app/backend/.env
ExecStart=/bin/bash /home/tradingapp/app/scripts/webhook-ingest-wrapper.sh
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webhook-ingest

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
