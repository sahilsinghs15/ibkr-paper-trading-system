[Unit]
Description=Trading session start — start IB Gateway and ensure services (09:30 ET)
After=network.target

[Service]
Type=oneshot
ExecStartPre=/home/tradingapp/app/backend/.venv/bin/python /home/tradingapp/app/scripts/holiday_guard.py
ExecStart=/usr/bin/systemctl start ibgateway.service
# Ensure 24/7 services are running
ExecStart=/usr/bin/systemctl start webhook-ingest.service
ExecStart=/usr/bin/systemctl start trading-backend.service
