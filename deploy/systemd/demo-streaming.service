[Unit]
Description=IBKR Demo Streaming Dashboard (read-only SSE)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service
# Demo is independent of process-manager — no After=process-manager
Requires=network.target

[Service]
Type=simple
User=tradingapp
WorkingDirectory=/home/tradingapp/app/backend
EnvironmentFile=/home/tradingapp/app/backend/.env
ExecStart=/home/tradingapp/app/backend/.venv/bin/python -m demo_streaming
ExecStartPost=-/bin/bash -c 'cd /home/tradingapp/app/backend && /home/tradingapp/app/backend/.venv/bin/python -m app.services.notification.cli start demo-streaming'
ExecStopPost=-/bin/bash -c 'cd /home/tradingapp/app/backend && /home/tradingapp/app/backend/.venv/bin/python -m app.services.notification.cli stop demo-streaming'
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=demo-streaming

NoNewPrivileges=true
PrivateTmp=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
