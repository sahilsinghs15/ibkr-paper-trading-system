+    op.drop_index(
+        "ix_kill_switch_operations_status_account",
+        table_name="kill_switch_operations",
+    )
+    op.drop_column("kill_switch_operations", "cleared_by")
+    op.drop_column("kill_switch_operations", "cleared_at")
